<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not "Spike.RazorConsole": that would shadow the library's RazorConsole.* namespaces. -->
    <RootNamespace>SpikeRazor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Note: 0.6.0 pulls Spectre.Console 0.54.0; the Launcher is on 0.49.1. -->
    <PackageReference Include="RazorConsole.Core" Version="0.6.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spike.Shared\Spike.Shared.csproj" />
  </ItemGroup>

</Project>
