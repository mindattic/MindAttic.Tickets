<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MindAttic.Tickets.Desktop</RootNamespace>
    <!-- Not MindAttic.Tickets: the library already ships MindAttic.Tickets.dll beside it. -->
    <AssemblyName>MindAttic.Tickets.Desktop</AssemblyName>
    <!-- Program.Main, not the generated one: a second start hands over its ticket before WPF loads (M.TIX-T133). -->
    <StartupObject>MindAttic.Tickets.Desktop.Program</StartupObject>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.1.0</Version>
    <!-- The exe's own icon: Explorer, the shortcuts and the taskbar all show it. -->
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon for the window's title bar. -->
    <Resource Include="..\..\assets\logo.ico" Link="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MindAttic.Components.Wpf" Version="23.0.0" />
    <PackageReference Include="MindAttic.Log" Version="3.0.0" />
    <PackageReference Include="MindAttic.Vault" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Tickets\MindAttic.Tickets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Tickets.Desktop.Tests" />
  </ItemGroup>

</Project>
