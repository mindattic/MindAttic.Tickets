<Application x:Class="MindAttic.Tickets.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme.xaml and Colors.xaml are merged inside Styles.xaml itself, not here, so a single, explicit
                     order controls which colour wins (Colors.xaml over Theme.xaml) and Styles.xaml's own styles can
                     reference the package's keys directly (M.TIX-T91). -->
                <ResourceDictionary Source="Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
