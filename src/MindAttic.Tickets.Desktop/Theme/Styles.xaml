<!-- Tickets Desktop's own controls: those MindAttic.Components.Wpf (M.COMP-T11) has no equivalent for: Combo, Check,
     RowList/RowItem (a drag-reorderable ListBox with a drop marker; the package's MaRowList is a plain ItemsControl
     with no drag support) and the Tickets grid view (GridHeader/GridRow) and Chip. Everything else (buttons, cards,
     the focus ring, text fields, pills) comes from the package's Theme.xaml (M.TIX-T91).

     Both Theme.xaml and Colors.xaml are merged below, in that order, instead of as separate entries in App.xaml:
     merging them here, inside this dictionary, is what lets this dictionary's own styles reference their keys with a
     plain StaticResource (Field's BasedOn MaTextBox, and the focus ring on Check and LinkBtn). A StaticResource
     inside a merged ResourceDictionary file only sees keys in its own file or in dictionaries it merges itself, not
     sibling files merged elsewhere in App.xaml. The order matters: Colors.xaml, merged second, wins any key the two
     share (MaMuted and MaControlBorder differ: Colors.xaml's are the WCAG 2.2 AA fixes from M.TIX-T71) exactly as it
     did when App.xaml listed Theme.xaml, then Colors.xaml, then this file side by side. Every brush is a
     DynamicResource from Colors.xaml so high contrast swaps them live, and every focusable control shows a 3:1 focus
     cue (2.4.7) and is at least 24x24 (2.5.8). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MindAttic.Components.Wpf;component/Theme.xaml" />
        <!-- An absolute pack URI, not a relative "Colors.xaml": a relative Source only resolves against a base URI,
             which a XamlReader.Load of this file from a raw stream (AutomationNameTests) has none of. -->
        <ResourceDictionary Source="pack://application:,,,/MindAttic.Tickets.Desktop;component/Theme/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- Tooltips: MindAttic.Components.Wpf's own implicit ToolTip style (Theme.xaml, merged before this dictionary in
         App.xaml) now covers the wrap-and-max-width look this used to define locally; a style here would just shadow
         it and let Tickets' tooltips drift from Orchestrator's. Still stay up until dismissed (ctl:MaToolTips.KeepOpen(),
         called from App's static constructor, WCAG 1.4.13). -->

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="PaneTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
        <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MaRec}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
    </Style>

    <!-- Card, Btn, PrimaryBtn and IconBtn moved into MindAttic.Components.Wpf as MaCard, MaButton, MaPrimaryButton and
         MaToolButton (M.COMP-T11, M.TIX-T91): views reference those directly now. LinkBtn stays here: the package
         has no plain-text link-style button (MaHyperlink is for a Hyperlink inside flow text, not a Button). -->
    <Style x:Key="LinkBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource MaFocus}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MaFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,2">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Inputs ────────────────────────────────────────────────────────── -->
    <!-- Rebased on the package's MaTextBox (M.COMP-T11, M.TIX-T91), keeping only the overrides that differ from it:
         its own BorderBrush token (FieldBorder, not MaFieldBorder: Tickets' own colour, unaffected by this move),
         and the taller Padding/MinHeight this views were built around (MaTextBox's defaults would shrink them). -->
    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource MaTextBox}">
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource MaText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="Background" Value="{DynamicResource MaSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="8,4,28,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <ToggleButton Style="{StaticResource ComboToggle}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="{DynamicResource MaChrome}" BorderBrush="{DynamicResource MaControlBorder}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MaFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource FieldBorder}" Background="{DynamicResource MaSurface}">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Visibility="Collapsed"
                                       Foreground="{DynamicResource MaOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource MaAccent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MaAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Choice rows ───────────────────────────────────────────────────── -->
    <!-- The view switcher's pill row moved into MindAttic.Components.Wpf as MaPillChoice (M.COMP-T11, M.TIX-T91);
         views reference it directly now. -->

    <!-- A list of ticket rows: arrow keys move, the selected row is outlined (not colour alone: a 2px border and the
         marker bar), and each row reads as one sentence to a screen reader. -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}" />
        <!-- A virtualizing panel lays rows out at the widest width it has ever seen, so after the list narrows (the detail
             pane opening, a smaller window, zoom) wrapped rows would run off its right edge. Pin each row to the viewport. -->
        <Setter Property="Width" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,0,0,6">
                        <Border x:Name="Drop" Height="3" VerticalAlignment="Top" Margin="0,-5,0,0" Background="{DynamicResource MaFocus}" Visibility="Collapsed" />
                        <Border x:Name="Bd" Background="{DynamicResource MaSurface}" BorderBrush="{DynamicResource MaChromeBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaControlBorder}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="Drop" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    </Style>

    <!-- A small labelled state chip: glyph + word, coloured border and text. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Grid (Tickets view) ───────────────────────────────────────────── -->
    <Style x:Key="GridHeader" TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border x:Name="Bd" Background="{DynamicResource MaChrome}" BorderBrush="{DynamicResource MaChromeBorder}"
                            BorderThickness="0,0,0,1" Padding="8,6">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridRow" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" SnapsToDevicePixels="True">
                        <GridViewRowPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaSurface}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaControlBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
