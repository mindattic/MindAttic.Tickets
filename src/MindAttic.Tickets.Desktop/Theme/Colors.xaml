<!-- Every colour Tickets Desktop uses, and the only place one is defined: views reference these as DynamicResource so
     high-contrast mode can swap them live (Theme/HighContrast.cs), and the contrast test reads them from here.
     Values follow MindAttic.Components.Wpf's theme, with the WCAG 2.2 AA fixes the Orchestrator made: text at least
     4.5:1 and borders, focus and state marks at least 3:1 on every background below. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="McChrome" Color="#FF1E1F24" />
    <SolidColorBrush x:Key="McPane" Color="#FF23252B" />
    <SolidColorBrush x:Key="McSurface" Color="#FF2A2C33" />
    <SolidColorBrush x:Key="McHover" Color="#FF2D2F37" />
    <SolidColorBrush x:Key="McAccent" Color="#FF3B5BDB" />
    <SolidColorBrush x:Key="McAccentHover" Color="#FF2F4AB8" />

    <!-- Text -->
    <SolidColorBrush x:Key="McText" Color="#FFE6E6EA" />
    <SolidColorBrush x:Key="McMuted" Color="#FFA4A6B0" />
    <SolidColorBrush x:Key="McOnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="McRec" Color="#FFFF7A7D" />

    <!-- Lines: decorative separators may be faint; anything that shows where a control is must be 3:1 (1.4.11). -->
    <SolidColorBrush x:Key="McChromeBorder" Color="#FF34363E" />
    <SolidColorBrush x:Key="McControlBorder" Color="#FF7C7E88" />
    <SolidColorBrush x:Key="FieldBorder" Color="#FF8A8C96" />
    <SolidColorBrush x:Key="McFocus" Color="#FF7AB8FF" />

    <!-- States, each always paired with a word or glyph (colour never carries meaning alone, 1.4.1). -->
    <SolidColorBrush x:Key="StateApproved" Color="#FF2FBF71" />
    <SolidColorBrush x:Key="StateProposed" Color="#FFF5A524" />
    <SolidColorBrush x:Key="StateRejected" Color="#FFFF7A7D" />
    <SolidColorBrush x:Key="StateOpen" Color="#FF7A93F0" />
    <SolidColorBrush x:Key="StateClosed" Color="#FF2FBF71" />
    <SolidColorBrush x:Key="StateWontDo" Color="#FFA4A6B0" />
</ResourceDictionary>
