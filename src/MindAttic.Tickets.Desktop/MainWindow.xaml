<Window x:Class="MindAttic.Tickets.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        xmlns:vm="clr-namespace:MindAttic.Tickets.Desktop.ViewModels"
        mc:MaWindow.DarkTitleBar="True"
        Title="MindAttic Tickets" Width="1360" Height="880" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Icon="/logo.ico"
        Background="{DynamicResource MaChrome}" Foreground="{DynamicResource MaText}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewTicketCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SyncCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static vm:WindowCommands.FocusSearch}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static vm:WindowCommands.ShowTickets}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static vm:WindowCommands.ShowQueue}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static vm:WindowCommands.ShowAudit}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static vm:WindowCommands.ShowBoard}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static vm:WindowCommands.ShowActivity}" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{x:Static vm:WindowCommands.ShowStats}" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{x:Static vm:WindowCommands.ShowStories}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static vm:WindowCommands.SaveStory}" />
        <KeyBinding Key="F1" Command="{x:Static vm:WindowCommands.Help}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static vm:WindowCommands.Undo}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{x:Static vm:WindowCommands.CommandPalette}" />
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{x:Static vm:WindowCommands.CommandPalette}" />
        <KeyBinding Key="Escape" Command="{x:Static vm:WindowCommands.Escape}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomResetCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ZoomResetCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="FilterLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
            <Setter Property="Padding" Value="0,0,0,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Approval chip: a glyph and a word in the state's colour. -->
        <Style x:Key="ApprovalChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="BorderBrush" Value="{DynamicResource StateProposed}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Approval}" Value="approved">
                    <Setter Property="BorderBrush" Value="{DynamicResource StateApproved}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Approval}" Value="rejected">
                    <Setter Property="BorderBrush" Value="{DynamicResource StateRejected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ApprovalText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource StateProposed}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Approval}" Value="approved">
                    <Setter Property="Foreground" Value="{DynamicResource StateApproved}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Approval}" Value="rejected">
                    <Setter Property="Foreground" Value="{DynamicResource StateRejected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource StateOpen}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="closed">
                    <Setter Property="Foreground" Value="{DynamicResource StateClosed}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="wont-do">
                    <Setter Property="Foreground" Value="{DynamicResource StateWontDo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- An implementing ticket, as a small chip under a story row (M.TIX-T185): its id, clickable, outlined in its
             ticket status colour. -->
        <Style x:Key="ImplementerChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="BorderBrush" Value="{DynamicResource StateOpen}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="closed">
                    <Setter Property="BorderBrush" Value="{DynamicResource StateClosed}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="wont-do">
                    <Setter Property="BorderBrush" Value="{DynamicResource StateWontDo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldName" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- What the version shown changed from the one before (Tag true): a tinted box with a 3:1 edge, and the version bar
             says it in words too (colour never carries meaning alone, 1.4.1). -->
        <Style x:Key="ChangedMark" TargetType="Border">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="-4,0,0,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MaChanged}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StateProposed}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One queue row. Its buttons are for the mouse; the keyboard uses the row's shortcuts and the action bar above. -->
        <DataTemplate x:Key="QueueRowTemplate" DataType="{x:Type vm:TicketRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="Auto" MinWidth="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rank}" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Repo}" Style="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,5,0,0">
                        <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource MaControlBorder}">
                            <TextBlock Text="{Binding Type}" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource ApprovalChip}">
                            <TextBlock Text="{Binding ApprovalText}" Style="{StaticResource ApprovalText}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource StateRejected}"
                                Visibility="{Binding BlockedText, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                            <TextBlock Text="{Binding BlockedText}" FontSize="12" Foreground="{DynamicResource StateRejected}" />
                        </Border>
                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{Binding Priority, StringFormat='priority {0}'}" />
                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding EstimateText}"
                                   Visibility="{Binding EstimateText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                        <!-- Its labels (M.TIX-T74): a '#' marks each, so they read as labels without colour. -->
                        <ItemsControl ItemsSource="{Binding TicketLabels}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource MaControlBorder}">
                                        <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="12" Foreground="{DynamicResource MaMuted}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <!-- Its live worker, from the Orchestrator's state: opens the Orchestrator on it (M.TIX-T135). -->
                    <Button Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,4,0,0" Focusable="False"
                            Content="{Binding WorkerText}" Visibility="{Binding WorkerText, Converter={x:Static vm:Converters.EmptyToCollapsed}}"
                            Command="{Binding DataContext.ShowWorkerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding WorkerName}" ToolTip="{Binding WorkerTip}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource MaToolButton}" Content="&#x2714;" Focusable="False" Margin="0,0,4,0"
                            Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Id, StringFormat='Approve {0}'}" ToolTip="Approve (A)" />
                    <Button Style="{StaticResource MaToolButton}" Content="&#x2716;" Focusable="False" Margin="0,0,10,0"
                            Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Id, StringFormat='Reject {0}'}" ToolTip="Reject: closes it as wont-do (R)" />
                    <Button Style="{StaticResource MaToolButton}" Content="&#x25B2;" Focusable="False" Margin="0,0,4,0"
                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Id, StringFormat='Move {0} up'}" ToolTip="Move up (Alt+Up)" />
                    <Button Style="{StaticResource MaToolButton}" Content="&#x25BC;" Focusable="False"
                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Id, StringFormat='Move {0} down'}" ToolTip="Move down (Alt+Down)" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One card on the Board (M.TIX-T77): the ticket in brief. Moves are by drag, or Alt+Left / Alt+Right. -->
        <DataTemplate x:Key="BoardCardTemplate" DataType="{x:Type vm:TicketRowViewModel}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Type}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Summary}" />
                <WrapPanel Margin="0,5,0,0">
                    <TextBlock Text="{Binding ApprovalText}" Style="{StaticResource ApprovalText}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" Margin="0,0,8,0" />
                    <TextBlock Text="⏸ blocked" FontSize="12" Foreground="{DynamicResource StateRejected}" ToolTip="{Binding BlockedText}"
                               Visibility="{Binding BlockedText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                </WrapPanel>
                <TextBlock Text="{Binding WorkerText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Visibility="{Binding WorkerText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, queue summary, and the actions every view shares (always in this place: 3.2.6). -->
        <DockPanel Margin="20,16,20,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource MaPrimaryButton}" Content="_New ticket" Command="{Binding NewTicketCommand}" Margin="0,0,8,0"
                        ToolTip="File a new ticket (Ctrl+N)" />
                <Button Style="{StaticResource MaButton}" Content="S_ync" Command="{Binding SyncCommand}" Margin="0,0,8,0"
                        ToolTip="Commit and push the ticket database: runs 'tickets db sync' (Ctrl+Shift+S)" />
                <Button Style="{StaticResource MaButton}" Content="_GitHub intake…" Command="{Binding IntakeCommand}" Margin="0,0,8,0"
                        ToolTip="File GitHub issues labelled 'orchestrator' and CI failures on main as tickets: shows a dry run first and files only when you click File ('tickets ticket intake')" />
                <Button Style="{StaticResource MaButton}" Content="_Export…" Command="{Binding ExportCommand}" Margin="0,0,8,0"
                        AutomationProperties.AcceleratorKey="Ctrl+E"
                        ToolTip="Save the tickets this view shows, with its filters, query and sort, as CSV or markdown (Ctrl+E); 'tickets ticket list --format csv|md' does the same from the CLI" />
                <Button Style="{StaticResource MaButton}" Content="_Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                        ToolTip="Read the database again (F5). It also refreshes by itself when agents change tickets." />
                <Button Style="{StaticResource MaButton}" Content="Commands…" Command="{x:Static vm:WindowCommands.CommandPalette}" Margin="0,0,8,0"
                        AutomationProperties.Name="Command palette" AutomationProperties.AcceleratorKey="Ctrl+K"
                        ToolTip="Jump to any ticket or story, or run any command, by typing part of its name (Ctrl+K)" />
                <Button Style="{StaticResource MaButton}" Content="_Help" Command="{x:Static vm:WindowCommands.Help}"
                        ToolTip="Keyboard shortcuts and how the queue works (F1)" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MindAttic Tickets" FontSize="22" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{Binding Headline}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- View switcher, search and filters. -->
        <WrapPanel Grid.Row="1" Margin="20,4,20,10">
            <StackPanel Margin="0,0,18,6">
                <Label Style="{StaticResource FilterLabel}" Content="View" Target="{Binding ElementName=ViewChoice}" />
                <ListBox x:Name="ViewChoice" Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Views}"
                         SelectedItem="{Binding SelectedView}" AutomationProperties.Name="View"
                         ToolTip="Repos: every repo with its tickets and git state (Ctrl+1). Queue: open tickets in the order /allocate takes them (Ctrl+2). Audit: closed tickets to double-check, and the Orchestrator's drift and duplicate-code findings (Ctrl+3). Board: tickets as cards in Proposed, Approved, In progress and Done; moving a card changes its approval or status (Ctrl+4). Activity: every ticket change across the workspace as it happens, newest first (Ctrl+5). Stats: throughput, cycle time and open tickets by repo and type over time, as tables (Ctrl+6). Stories: every repo's user stories under their epics, to edit their text, status, acceptance and evidence and link the tickets that implement them (Ctrl+7)." />
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
                <Label Style="{StaticResource FilterLabel}" Content="_Search (Ctrl+F)" Target="{Binding ElementName=SearchBox}" />
                <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Width="260" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         AutomationProperties.Name="Search tickets by ID, summary, ref or repo" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Visibility="{Binding ShowsTicketFilters, Converter={StaticResource Visible}}">
                <Label Style="{StaticResource FilterLabel}" Content="_Query" Target="{Binding ElementName=QueryBox}" />
                <TextBox x:Name="QueryBox" Style="{StaticResource Field}" Width="300" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         AutomationProperties.Name="Ticket query"
                         AutomationProperties.HelpText="{Binding QueryError}"
                         ToolTip="repo:NAME or CODE, type:fix, status:open, label:ui, approval:approved and free text ('quoted' keeps spaces). Commas give alternatives (status:open,wont-do), a leading - negates (-type:chore), * is a wildcard in repo and label." />
                <TextBlock Text="{Binding QueryError}" Style="{StaticResource ErrorText}" MaxWidth="300" TextWrapping="Wrap"
                           Visibility="{Binding QueryError, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Visibility="{Binding ShowsTicketFilters, Converter={StaticResource Visible}}">
                <Label Style="{StaticResource FilterLabel}" Content="Sa_ved filter" Target="{Binding ElementName=SavedFilterBox}" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="SavedFilterBox" Style="{StaticResource Combo}" MinWidth="150" ItemsSource="{Binding SavedFilterChoices}"
                              SelectedItem="{Binding SelectedSavedFilter}" AutomationProperties.Name="Saved filter"
                              ToolTip="Named queries kept in the ticket database (also 'tickets filter list' and 'tickets ticket list --filter')." />
                    <Button Style="{StaticResource MaButton}" Content="Save…" Command="{Binding SaveFilterCommand}" Margin="6,0,0,0"
                            ToolTip="Save the query as a named filter" />
                    <Button Style="{StaticResource MaButton}" Content="Delete" Command="{Binding DeleteFilterCommand}" Margin="6,0,0,0"
                            ToolTip="Delete the picked saved filter" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
                <Label Style="{StaticResource FilterLabel}" Content="Rep_o" Target="{Binding ElementName=RepoBox}" />
                <ComboBox x:Name="RepoBox" Style="{StaticResource Combo}" MinWidth="190" ItemsSource="{Binding RepoChoices}"
                          SelectedItem="{Binding RepoFilter}" AutomationProperties.Name="Repo filter" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Visibility="{Binding ShowsTicketFilters, Converter={StaticResource Visible}}">
                <Label Style="{StaticResource FilterLabel}" Content="_Type" Target="{Binding ElementName=TypeBox}" />
                <ComboBox x:Name="TypeBox" Style="{StaticResource Combo}" ItemsSource="{Binding TypeChoices}"
                          SelectedItem="{Binding TypeFilter}" AutomationProperties.Name="Type filter" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Visibility="{Binding ShowsTicketFilters, Converter={StaticResource Visible}}">
                <Label Style="{StaticResource FilterLabel}" Content="_Approval" Target="{Binding ElementName=ApprovalBox}" />
                <ComboBox x:Name="ApprovalBox" Style="{StaticResource Combo}" MinWidth="140" ItemsSource="{Binding ApprovalChoices}"
                          SelectedItem="{Binding ApprovalFilter}" AutomationProperties.Name="Approval filter" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Visibility="{Binding ShowsTicketFilters, Converter={StaticResource Visible}}">
                <Label Style="{StaticResource FilterLabel}" Content="Wor_k" Target="{Binding ElementName=WorkBox}" />
                <ComboBox x:Name="WorkBox" Style="{StaticResource Combo}" MinWidth="150" ItemsSource="{Binding WorkChoices}"
                          SelectedItem="{Binding WorkFilter}" AutomationProperties.Name="Work filter"
                          ToolTip="Queued: open, a fix or approved, and not blocked (what /allocate takes next). Needs approval: open and not yet approved. Blocked: waiting on other open tickets." />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Visibility="{Binding ShowsTicketFilters, Converter={StaticResource Visible}}">
                <Label Style="{StaticResource FilterLabel}" Content="_Label" Target="{Binding ElementName=LabelBox}" />
                <ComboBox x:Name="LabelBox" Style="{StaticResource Combo}" MinWidth="150" ItemsSource="{Binding LabelChoices}"
                          SelectedItem="{Binding LabelFilter}" AutomationProperties.Name="Label filter"
                          ToolTip="Only tickets with this label. A component is a 'component:' label. Add labels from a ticket's details, or 'tickets ticket label add'." />
            </StackPanel>
            <!-- Stories (M.TIX-T82): their own status filter and grouping; search and repo narrow them too. -->
            <StackPanel Margin="0,0,12,6" Visibility="{Binding IsStoriesView, Converter={StaticResource Visible}}">
                <Label Style="{StaticResource FilterLabel}" Content="Story stat_us" Target="{Binding ElementName=StoryStatusBox}" />
                <ComboBox x:Name="StoryStatusBox" Style="{StaticResource Combo}" MinWidth="130" ItemsSource="{Binding StoryStatusChoices}"
                          SelectedItem="{Binding StoryStatusFilter}" AutomationProperties.Name="Story status filter" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" VerticalAlignment="Bottom" Visibility="{Binding IsStoriesView, Converter={StaticResource Visible}}">
                <CheckBox Style="{StaticResource Check}" Content="_Group by epic" IsChecked="{Binding GroupByEpic}" Margin="0,0,0,6"
                          ToolTip="List each epic's stories under a heading with its title, and New story and Rename buttons." />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Visibility="{Binding IsTicketsView, Converter={StaticResource Visible}}">
                <Label Style="{StaticResource FilterLabel}" Content="Stat_us" Target="{Binding ElementName=StatusBox}" />
                <ComboBox x:Name="StatusBox" Style="{StaticResource Combo}" ItemsSource="{Binding StatusChoices}"
                          SelectedItem="{Binding StatusFilter}" AutomationProperties.Name="Status filter" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Visibility="{Binding IsTicketsView, Converter={StaticResource Visible}}">
                <Label Style="{StaticResource FilterLabel}" Content="Sort _by" Target="{Binding ElementName=SortBox}" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="SortBox" Style="{StaticResource Combo}" ItemsSource="{Binding SortChoices}"
                              SelectedItem="{Binding SortBy}" AutomationProperties.Name="Sort by" />
                    <CheckBox Style="{StaticResource Check}" Content="Descending" IsChecked="{Binding SortDescending}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,12,6" VerticalAlignment="Bottom" Visibility="{Binding IsTicketsView, Converter={StaticResource Visible}}">
                <CheckBox Style="{StaticResource Check}" Content="_Group by repo" IsChecked="{Binding GroupByRepo}" Margin="0,0,0,6"
                          ToolTip="List each repo's tickets together under its name, sorted within it." />
                <CheckBox Style="{StaticResource Check}" Content="Show closed and wont-do" IsChecked="{Binding ShowArchived}"
                          ToolTip="Closed and wont-do tickets are archived: hidden unless this is on or a status is picked." />
            </StackPanel>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Queue and Repos take a multi-selection (M.TIX-T79): with several selected, this bar acts on every one of them. -->
            <DockPanel>
            <Border DockPanel.Dock="Top" Margin="20,0,12,8" Padding="10,6,10,2" CornerRadius="6" Background="{DynamicResource MaSurface}"
                    BorderBrush="{DynamicResource MaAccent}" BorderThickness="1"
                    Visibility="{Binding IsMultiSelect, Converter={StaticResource Visible}}"
                    AutomationProperties.Name="Bulk actions on the selected tickets">
                <WrapPanel>
                    <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,4" />
                    <Button Style="{StaticResource MaButton}" Content="Approve" Command="{Binding ApproveCommand}" Margin="0,0,6,4" ToolTip="Approve every selected open ticket (A)" />
                    <Button Style="{StaticResource MaButton}" Content="Unapprove" Command="{Binding UnapproveCommand}" Margin="0,0,6,4" ToolTip="Put every selected ticket back to proposed (U)" />
                    <Button Style="{StaticResource MaButton}" Content="Reject…" Command="{Binding RejectCommand}" Margin="0,0,6,4" ToolTip="Reject every selected open ticket with one reason: each closes as wont-do (R)" />
                    <Button Style="{StaticResource MaButton}" Content="Close…" Command="{Binding CloseRowsCommand}" Margin="0,0,6,4" ToolTip="Close every selected open ticket, with an optional ref (C)" />
                    <Button Style="{StaticResource MaButton}" Content="Won't do…" Command="{Binding WontDoRowsCommand}" Margin="0,0,6,4" ToolTip="Close every selected open ticket as wont-do, with a reason (W)" />
                    <Button Style="{StaticResource MaButton}" Content="Set type…" Command="{Binding SetTypeRowsCommand}" Margin="0,0,14,4" ToolTip="Set the type of every selected ticket, recorded on each with a reason (T)" />
                    <Button Style="{StaticResource MaButton}" Content="To top" Command="{Binding MoveTopCommand}" Margin="0,0,6,4" ToolTip="Move the selected tickets to the top of the queue, in their order (Alt+Home)" />
                    <Button Style="{StaticResource MaButton}" Content="To bottom" Command="{Binding MoveBottomCommand}" Margin="0,0,14,4" ToolTip="Move the selected tickets to the bottom of the queue, in their order (Alt+End)" />
                    <Button Style="{StaticResource MaButton}" Content="Clear selection" Command="{Binding ClearSelectionCommand}" Margin="0,0,0,4" ToolTip="Select just one ticket again (Esc)" />
                </WrapPanel>
            </Border>
            <Grid>
            <!-- ── Queue ── -->
            <Grid Margin="20,0,12,0" Visibility="{Binding IsQueueView, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Style="{StaticResource MaButton}" Content="Approve" Command="{Binding ApproveCommand}" Margin="0,0,6,4" ToolTip="Approve the selected ticket (A)" />
                        <Button Style="{StaticResource MaButton}" Content="Unapprove" Command="{Binding UnapproveCommand}" Margin="0,0,6,4" ToolTip="Back to proposed (U)" />
                        <Button Style="{StaticResource MaButton}" Content="Reject…" Command="{Binding RejectCommand}" Margin="0,0,14,4" ToolTip="Reject: closes it as wont-do with your reason (R)" />
                        <Button Style="{StaticResource MaButton}" Content="To top" Command="{Binding MoveTopCommand}" Margin="0,0,6,4" ToolTip="Move to the top (Alt+Home)" />
                        <Button Style="{StaticResource MaToolButton}" Content="&#x25B2;" Command="{Binding MoveUpCommand}" Margin="0,0,6,4"
                                AutomationProperties.Name="Move up" ToolTip="Move up (Alt+Up)" />
                        <Button Style="{StaticResource MaToolButton}" Content="&#x25BC;" Command="{Binding MoveDownCommand}" Margin="0,0,0,4"
                                AutomationProperties.Name="Move down" ToolTip="Move down (Alt+Down)" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,4"
                               Text="In the order /allocate hands tickets out, highest priority first. Drag a ticket, or select it and press Alt+Up / Alt+Down, to change its place; fixes and approved tickets are what /allocate works. A ticket being worked shows who has it: click to open the Orchestrator on it." />
                </DockPanel>
                <ListBox x:Name="QueueList" Grid.Row="1" Style="{StaticResource RowList}" ItemsSource="{Binding QueueRows}"
                         SelectedItem="{Binding SelectedQueueRow}" ItemTemplate="{StaticResource QueueRowTemplate}"
                         SelectionMode="Extended" SelectionChanged="OnListSelectionChanged"
                         AutomationProperties.Name="Queue: open tickets in priority order" AllowDrop="True"
                         PreviewKeyDown="OnQueueKeyDown" PreviewMouseLeftButtonDown="OnQueueMouseDown" PreviewMouseMove="OnQueueMouseMove"
                         DragOver="OnQueueDragOver" DragLeave="OnQueueDragLeave" Drop="OnQueueDrop" />
                <TextBlock Grid.Row="1" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           Text="No open tickets match." AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Visibility>
                        <Binding Path="QueueRows.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>

            <!-- ── Tickets ── -->
            <ListView x:Name="TicketList" Margin="20,0,12,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MaText}"
                      Visibility="{Binding IsTicketsView, Converter={StaticResource Visible}}"
                      ItemsSource="{Binding TicketRows}" SelectedItem="{Binding SelectedTicketRow}" ItemContainerStyle="{StaticResource GridRow}"
                      AutomationProperties.Name="Tickets" PreviewKeyDown="OnTicketsKeyDown"
                      SelectionMode="Extended" SelectionChanged="OnListSelectionChanged"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      KeyboardNavigation.TabNavigation="Once">
                <!-- Group by repo: a heading per repo with its count (shown when the list is grouped; MainWindow sets the grouping). -->
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <!-- The group's Name is the repo's RepoHeaderViewModel (M.TIX-T135): its counts, git state and Start link. -->
                            <DataTemplate>
                                <WrapPanel Margin="4,12,0,4">
                                    <TextBlock Text="{Binding Name.Name}" FontWeight="SemiBold" FontSize="14" AutomationProperties.HeadingLevel="Level2" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ItemCount, StringFormat='  {0} tickets'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name.Counts, StringFormat='  ·  {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name.Git, StringFormat='  ·  git: {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource LinkBtn}" Content="Start" Margin="14,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.StartCliCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}"
                                            AutomationProperties.Name="{Binding Name.StartName}" ToolTip="Open the Orchestrator to start a CLI in this repo" />
                                </WrapPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GridHeader}">
                        <GridViewColumn Width="120">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="ID" Command="{Binding ToggleSortCommand}" CommandParameter="ID" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Id}" FontWeight="SemiBold" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="170">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Repo" Command="{Binding ToggleSortCommand}" CommandParameter="Repo" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Repo}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="80">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Type" Command="{Binding ToggleSortCommand}" CommandParameter="Type" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Type}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Status" Command="{Binding ToggleSortCommand}" CommandParameter="Status" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" />
                                        <TextBlock Text="⏸ blocked" FontSize="12" Foreground="{DynamicResource StateRejected}" ToolTip="{Binding BlockedText}"
                                                   Visibility="{Binding BlockedText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="110">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Approval" Command="{Binding ToggleSortCommand}" CommandParameter="Approval" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding ApprovalText}" Style="{StaticResource ApprovalText}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="96">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Date" Command="{Binding ToggleSortCommand}" CommandParameter="Date" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Date}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="560">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Summary" Command="{Binding ToggleSortCommand}" CommandParameter="Summary" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="180" Header="Labels">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding LabelsText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LabelsText}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            </Grid>
            </DockPanel>

            <!-- ── Board (M.TIX-T77): a column per stage; moving a card changes its approval, work record or status ── -->
            <Grid Margin="20,0,12,0" Visibility="{Binding IsBoardView, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Drag a card to another column, or select it and press Alt+Left / Alt+Right. Proposed unapproves it, Approved approves it, In progress approves it and marks it worked by hand, Done closes it (asking for an optional ref). A closed ticket can't be reopened. Left / Right move between columns." />
                <ItemsControl Grid.Row="1" ItemsSource="{Binding BoardColumns}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BoardColumnViewModel}">
                            <Border Background="{DynamicResource MaPane}" CornerRadius="6" Padding="8" Margin="0,0,8,0" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource MaChromeBorder}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" FontWeight="SemiBold" Margin="2,0,0,8"
                                               AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
                                    <Grid>
                                        <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource BoardCardTemplate}"
                                                 AllowDrop="True" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} column'}"
                                                 SelectionChanged="OnBoardSelectionChanged" PreviewKeyDown="OnBoardKeyDown"
                                                 PreviewMouseLeftButtonDown="OnBoardMouseDown" PreviewMouseMove="OnBoardMouseMove"
                                                 DragOver="OnBoardDragOver" DragLeave="OnBoardDragLeave" Drop="OnBoardDrop" />
                                        <TextBlock Style="{StaticResource Muted}" Text="No tickets." HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" IsHitTestVisible="False">
                                            <TextBlock.Visibility>
                                                <Binding Path="Rows.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ── Audit: the Orchestrator's findings, read-only (M.TIX-T135) ── -->
            <ScrollViewer Margin="20,0,12,0" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding IsAuditView, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="{Binding AuditSummary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Ticket hygiene is read from the ticket database, the rest from the Orchestrator's; the repo filter and search narrow every list." />

                    <!-- Ticket hygiene, from the ticket database ('tickets ticket hygiene', M.TIX-T138). -->
                    <TextBlock Text="{Binding HygieneRows.Count, StringFormat='TICKET HYGIENE: CLOSED TICKETS TO DOUBLE-CHECK ({0})'}" Style="{StaticResource SectionLabel}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Fixes and features closed with no Ref (no test or commit cited), and closed tickets a later ticket says came back." />
                    <ItemsControl ItemsSource="{Binding HygieneRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Repo}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource LinkBtn}" Content="{Binding TicketId}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding TicketId}"
                                                AutomationProperties.Name="{Binding TicketId, StringFormat='Open {0}'}" ToolTip="Open the ticket" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding DriftRows.Count, StringFormat='DRIFT: SHARED FILES THAT DIFFER ({0})'}" Style="{StaticResource SectionLabel}" AutomationProperties.HeadingLevel="Level2" />
                    <ItemsControl ItemsSource="{Binding DriftRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Repo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding File, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SimilarityText, Mode=OneWay}" /></TextBlock>
                                    <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MaMuted}" Padding="0" TextWrapping="Wrap" AutomationProperties.Name="Path" />
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                               Text="{Binding CanonicalPath, StringFormat='most repos match {0}'}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding MissingRows.Count, StringFormat='MISSING: SHARED FILES A REPO LACKS ({0})'}" Style="{StaticResource SectionLabel}" AutomationProperties.HeadingLevel="Level2" />
                    <ItemsControl ItemsSource="{Binding MissingRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="{Binding Repo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding File, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" /></TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding DuplicateRows.Count, StringFormat='DUPLICATE CODE ACROSS REPOS ({0})'}" Style="{StaticResource SectionLabel}" AutomationProperties.HeadingLevel="Level2" />
                    <ItemsControl ItemsSource="{Binding DuplicateRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Facts}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding FileList, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MaMuted}" Padding="0" TextWrapping="Wrap" AutomationProperties.Name="Files" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Activity (M.TIX-T84): every ticket change across the workspace, newest first, live ── -->
            <Grid Margin="20,0,12,0" Visibility="{Binding IsActivityView, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Every ticket change in every repo as it happens, newest first, from the ticket database's history. A toast says when an agent closes a ticket. The repo filter and search narrow the feed; select a change to open its ticket." />
                <ListBox x:Name="ActivityList" Grid.Row="1" Style="{StaticResource RowList}" ItemsSource="{Binding ActivityRows}"
                         SelectedItem="{Binding SelectedActivityRow}" AutomationProperties.Name="Activity: ticket changes, newest first"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ActivityRowViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" MinWidth="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding TicketId}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Repo}" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsClose}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource StateClosed}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           Text="No changes match." AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Visibility>
                        <Binding Path="ActivityRows.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>

            <!-- Stories (M.TIX-T82): every repo's stories under their epics; the selected one opens in the editor beside the list. -->
            <Grid Margin="20,0,12,0" Visibility="{Binding IsStoriesView, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Style="{StaticResource MaButton}" Content="New stor_y&#x2026;" Command="{Binding NewStoryCommand}" Margin="0,0,6,4"
                                ToolTip="Add a story under an epic of the repo shown; it opens in the editor" />
                        <Button Style="{StaticResource MaButton}" Content="New e_pic&#x2026;" Command="{Binding NewEpicCommand}" Margin="0,0,0,4"
                                ToolTip="Add an epic (its key and title) to a repo" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,4"
                               Text="Each repo's user stories, in their epics' order. Select one to edit its statement, status, acceptance and evidence (Ctrl+S saves, Esc goes back to the list) and the tickets that implement it. Saving rewrites the repo's USER_STORIES.md view." />
                </DockPanel>
                <ListBox x:Name="StoryList" Grid.Row="1" Style="{StaticResource RowList}" ItemsSource="{Binding StoryRows}"
                         SelectedItem="{Binding SelectedStoryRow}" AutomationProperties.Name="Stories, by epic"
                         PreviewKeyDown="OnStoriesKeyDown"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <!-- Group by epic: a heading per epic (MainWindow sets the grouping) with its own New story and Rename,
                         a rollup of its implementing tickets' progress, what to work on next, and a collapse toggle that's
                         remembered between runs (M.TIX-T182, M.TIX-T183, M.TIX-T184, M.TIX-T187). -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,12,0,4">
                                        <WrapPanel>
                                            <Button Style="{StaticResource MaToolButton}" Width="22" Height="22" FontSize="11" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.ToggleEpicCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}"
                                                    Content="{Binding Name.ChevronGlyph}" AutomationProperties.Name="{Binding Name.ToggleName}"
                                                    ToolTip="Expand or collapse this group" />
                                            <TextBlock Text="{Binding Name.Heading}" FontWeight="SemiBold" FontSize="14" AutomationProperties.HeadingLevel="Level2" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ItemCount, StringFormat='  {0} stories'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name.RollupText, StringFormat='  ·  {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                       Visibility="{Binding Name.IsEpic, Converter={StaticResource Visible}}" />
                                            <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource StateRejected}" Margin="10,0,0,0"
                                                    Visibility="{Binding Name.BlockedCount, Converter={x:Static vm:Converters.PositiveToVisible}}"
                                                    ToolTip="Open implementing tickets waiting on another open ticket">
                                                <TextBlock Text="{Binding Name.BlockedCount, StringFormat='{}{0} blocked'}" FontSize="12" Foreground="{DynamicResource StateRejected}" />
                                            </Border>
                                            <Button Style="{StaticResource LinkBtn}" Content="New story" Margin="14,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding Name.IsEpic, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.NewStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}"
                                                    AutomationProperties.Name="{Binding Name.NewStoryName}" ToolTip="Add a story to this epic" />
                                            <Button Style="{StaticResource LinkBtn}" Content="Rename" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding Name.IsEpic, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.RenameEpicCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}"
                                                    AutomationProperties.Name="{Binding Name.RenameName}" ToolTip="Rename this epic; its stories keep their IDs" />
                                        </WrapPanel>
                                        <ProgressBar Style="{StaticResource MaProgressBar}" Minimum="0" Maximum="1" Value="{Binding Name.DoneFraction, Mode=OneWay}"
                                                     Width="200" HorizontalAlignment="Left" Margin="30,4,0,0" ToolTip="{Binding Name.RollupText}"
                                                     AutomationProperties.Name="{Binding Name.RollupText}"
                                                     Visibility="{Binding Name.IsEpic, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding Name.NextUpText}" Style="{StaticResource Muted}" Margin="30,2,0,0"
                                                   Visibility="{Binding Name.NextUpText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel>
                                                    <ContentPresenter />
                                                    <ItemsPresenter Visibility="{Binding Name.IsExpanded, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StoryRowViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Repo}" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Statement}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" ToolTip="{Binding Statement}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,0,10,0" />
                                        <TextBlock Text="unsaved edits" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource StateProposed}"
                                                   Visibility="{Binding IsEdited, Converter={StaticResource Visible}}" />
                                    </WrapPanel>
                                    <!-- Implementing tickets as chips (M.TIX-T185), not just the muted ImplementersText a screen reader
                                         still gets via AutomationProperties.Name below. -->
                                    <TextBlock Text="No implementing tickets" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Visibility="{Binding Implementers.Count, Converter={x:Static vm:Converters.ZeroToVisible}}" />
                                    <ItemsControl ItemsSource="{Binding Implementers}" Focusable="False" Margin="0,4,0,0"
                                                  AutomationProperties.Name="{Binding ImplementersText}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ImplementerLine}">
                                                <Border Style="{StaticResource ImplementerChip}">
                                                    <Button Style="{StaticResource LinkBtn}" Content="{Binding TicketId}" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding TicketId}"
                                                            AutomationProperties.Name="{Binding SpokenName, StringFormat='{}{0}: go to it'}" ToolTip="{Binding Summary}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           Text="No stories match." AutomationProperties.LiveSetting="Polite" IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="StoryRows.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>

            <!-- Toasts (M.TIX-T84): an agent closed a ticket. Bottom right, over the lists; each goes by itself, or with ✕;
                 clicking one opens its ticket. The announcer says each one too (4.1.3). -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Toasts}" Focusable="False" Panel.ZIndex="10"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,12" Width="360"
                          AutomationProperties.Name="Notifications">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ActivityToast}">
                        <Border Background="{DynamicResource MaPane}" BorderBrush="{DynamicResource StateClosed}" BorderThickness="1,1,1,1"
                                CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#x2715;" VerticalAlignment="Top" Margin="8,0,0,0"
                                        Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title, StringFormat='Dismiss: {0}'}" ToolTip="Dismiss" />
                                <Button Style="{StaticResource LinkBtn}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.OpenToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Spoken}" ToolTip="Open the ticket">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Body}" Foreground="{DynamicResource MaText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── Detail pane ── -->
            <!-- ── Stats (M.TIX-T86): ticket metrics as real tables (a DataGrid each, with column headers, read as a table) ── -->
            <ScrollViewer Margin="20,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False"
                          PreviewMouseWheel="OnStatsMouseWheel" Visibility="{Binding IsStatsView, Converter={StaticResource Visible}}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,6">
                            <Label Style="{StaticResource FilterLabel}" Content="_Period" Target="{Binding ElementName=StatsByBox}" />
                            <ComboBox x:Name="StatsByBox" Style="{StaticResource Combo}" MinWidth="110" ItemsSource="{Binding StatsByChoices}"
                                      SelectedItem="{Binding StatsBy}" AutomationProperties.Name="Period"
                                      ToolTip="Day: the last 14 days. Week: the last 8 weeks, Monday to Sunday. Month: the last 6 months. All in UTC." />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatsSummary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <TextBlock Text="THROUGHPUT: FILED, CLOSED AND OPEN PER PERIOD" Style="{StaticResource SectionLabel}" AutomationProperties.HeadingLevel="Level2" />
                    <DataGrid Style="{StaticResource StatsTable}" ItemsSource="{Binding ThroughputTable}" AutoGeneratingColumn="OnStatsAutoGeneratingColumn"
                              AutomationProperties.Name="Throughput: tickets filed, closed, closed as wont-do, and open at the end of each period" />

                    <TextBlock Text="CYCLE TIME: FILED TO CLOSED, BY TYPE" Style="{StaticResource SectionLabel}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Tickets closed in these periods: how long each was open, from filing to closing (m minutes, h hours, d days). Wont-do and tickets filed already closed aren't counted." />
                    <DataGrid Style="{StaticResource StatsTable}" ItemsSource="{Binding CycleTable}" AutoGeneratingColumn="OnStatsAutoGeneratingColumn"
                              AutomationProperties.Name="Cycle time by type: how many closed, and the median, mean and 85th percentile time from filing to closing" />

                    <TextBlock Text="OPEN AT THE END OF EACH PERIOD, BY REPO" Style="{StaticResource SectionLabel}" AutomationProperties.HeadingLevel="Level2" />
                    <DataGrid Style="{StaticResource StatsTable}" ItemsSource="{Binding OpenByRepoTable}" AutoGeneratingColumn="OnStatsAutoGeneratingColumn"
                              AutomationProperties.Name="Open tickets by repo: a row per repo, a column per period" />

                    <TextBlock Text="OPEN AT THE END OF EACH PERIOD, BY TYPE" Style="{StaticResource SectionLabel}" AutomationProperties.HeadingLevel="Level2" />
                    <DataGrid Style="{StaticResource StatsTable}" ItemsSource="{Binding OpenByTypeTable}" AutoGeneratingColumn="OnStatsAutoGeneratingColumn"
                              AutomationProperties.Name="Open tickets by type: a row per type, a column per period" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── Detail pane ── -->
            <Border Grid.Column="1" Width="430" Background="{DynamicResource MaPane}" BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowsDetailPane, Converter={StaticResource Visible}}">
                <ScrollViewer x:Name="DetailPane" VerticalScrollBarVisibility="Auto" Focusable="False" DataContext="{Binding Detail}" PreviewKeyDown="OnDetailKeyDown">
                    <StackPanel Margin="20,16,20,20">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#x2715;" VerticalAlignment="Top"
                                    Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AutomationProperties.Name="Close details" ToolTip="Close details (Esc)" />
                            <TextBlock x:Name="DetailTitle" Text="{Binding Id}" Style="{StaticResource PaneTitle}" Focusable="True" FocusVisualStyle="{StaticResource MaFocusRing}" />
                        </DockPanel>

                        <!-- Versions (M.TIX-T137): the arrows, or Left / Right, step through every save; the rightmost is the ticket now. -->
                        <Border Style="{StaticResource MaCard}" Margin="0,10,0,0" Padding="6,6"
                                Visibility="{Binding HasVersions, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource MaToolButton}" Content="&#x25C0;" VerticalAlignment="Center"
                                        Command="{Binding DataContext.OlderVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="Older version" ToolTip="Older version (Left)" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#x25B6;" VerticalAlignment="Center"
                                        Command="{Binding DataContext.NewerVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="Newer version" ToolTip="Newer version (Right)" />
                                <StackPanel Margin="10,0">
                                    <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding VersionWhen}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding ChangesText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource ChangedMark}" Tag="{Binding SummaryChanged}" Margin="-4,8,0,0">
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="14" />
                        </Border>
                        <!-- The markdown description (M.TIX-T73), kept apart from the summary; selectable so it can be copied. -->
                        <StackPanel Visibility="{Binding HasDescription, Converter={StaticResource Visible}}">
                            <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionLabel}" />
                            <TextBox Text="{Binding Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent"
                                     BorderThickness="0" Foreground="{DynamicResource MaText}" Padding="0" FontFamily="Cascadia Mono, Consolas"
                                     AutomationProperties.Name="Description" />
                        </StackPanel>
                        <TextBlock Text="{Binding WorkText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <!-- Being worked (M.TIX-T134): its login and session link back to the Orchestrator, which runs the work. -->
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding WorkingText}" TextWrapping="Wrap" />
                            <!-- M.TIX-T158: asks the dashboard over the app bus to select the person and CLI tab working it. -->
                            <Button Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,2" Content="Show who's working this"
                                    Visibility="{Binding ShowsWorkerInWorkPanel, Converter={StaticResource Visible}}"
                                    Command="{Binding DataContext.ShowWorkerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"
                                    AutomationProperties.Name="{Binding Id, StringFormat='Show who is working {0} in the Orchestrator'}" ToolTip="Show the person and CLI tab working it in the Orchestrator" />
                            <ItemsControl ItemsSource="{Binding OrchestratorTargets}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OrchestratorTarget}">
                                        <Button Style="{StaticResource LinkBtn}" Content="{Binding Text}" HorizontalAlignment="Left" Margin="0,2"
                                                Command="{Binding DataContext.OpenInOrchestratorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Target}"
                                                AutomationProperties.Name="{Binding SpokenName}" ToolTip="Open the Orchestrator on it" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- Claimed (M.TIX-T76): the Orchestrator's assignment, its agent, worktree and since when; opens the Orchestrator on it. -->
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasWorker, Converter={StaticResource Visible}}"
                                    AutomationProperties.Name="{Binding ClaimSpoken}">
                            <TextBlock Text="{Binding ClaimText}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding ClaimWorktree, StringFormat='Worktree {0}'}"
                                       Visibility="{Binding ClaimWorktree, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding ClaimSince, StringFormat='Since {0}'}"
                                       Visibility="{Binding ClaimSince, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding ClaimSession, StringFormat='Session {0}'}"
                                       Visibility="{Binding ClaimSession, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                            <Button Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,2" Content="Show who's working this"
                                    Command="{Binding DataContext.ShowWorkerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"
                                    AutomationProperties.Name="{Binding Id, StringFormat='Show who is working {0} in the Orchestrator'}" ToolTip="Show the person and CLI tab working it in the Orchestrator" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldName}" Text="Repo" />
                            <Border Grid.Column="1" Style="{StaticResource ChangedMark}" Tag="{Binding RepoChanged}">
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Repo}" />
                            </Border>
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldName}" Text="Type" />
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChangedMark}" Tag="{Binding TypeChanged}">
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Type}" />
                            </Border>
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldName}" Text="Status" />
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ChangedMark}" Tag="{Binding StatusChanged}">
                                <TextBlock Style="{StaticResource StatusText}" FontSize="13" Margin="0,3" Text="{Binding StatusText}" />
                            </Border>
                            <TextBlock Grid.Row="3" Style="{StaticResource FieldName}" Text="Approval" />
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ChangedMark}" Tag="{Binding ApprovalChanged}">
                                <TextBlock Style="{StaticResource ApprovalText}" FontSize="13" Margin="0,3" Text="{Binding ApprovalText}" />
                            </Border>
                            <TextBlock Grid.Row="4" Style="{StaticResource FieldName}" Text="Priority" />
                            <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource ChangedMark}" Tag="{Binding PriorityChanged}">
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Priority}" />
                            </Border>
                            <TextBlock Grid.Row="5" Style="{StaticResource FieldName}" Text="Filed" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Date}" />
                            <TextBlock Grid.Row="6" Style="{StaticResource FieldName}" Text="Ref" />
                            <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource ChangedMark}" Tag="{Binding RefChanged}" HorizontalAlignment="Stretch">
                                <TextBox Text="{Binding Ref, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent"
                                         BorderThickness="0" Foreground="{DynamicResource MaText}" Padding="0" Margin="0,3" AutomationProperties.Name="Ref" />
                            </Border>
                            <TextBlock Grid.Row="7" Style="{StaticResource FieldName}" Text="Assigned" />
                            <Border Grid.Row="7" Grid.Column="1" Style="{StaticResource ChangedMark}" Tag="{Binding AssigneeChanged}">
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding AssigneeText}" />
                            </Border>
                            <TextBlock Grid.Row="8" Style="{StaticResource FieldName}" Text="Reserved" />
                            <Border Grid.Row="8" Grid.Column="1" Style="{StaticResource ChangedMark}" Tag="{Binding ReservedChanged}">
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding ReservedText}" />
                            </Border>
                            <TextBlock Grid.Row="9" Style="{StaticResource FieldName}" Text="Estimate" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding EstimateText}" />
                        </Grid>

                        <TextBlock Text="ACTIONS" Style="{StaticResource SectionLabel}" />
                        <WrapPanel>
                            <Button Style="{StaticResource MaButton}" Content="Approve" Margin="0,0,6,6"
                                    Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Reject…" Margin="0,0,6,6"
                                    Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Close…" Margin="0,0,6,6" ToolTip="Close as done, optionally setting its ref"
                                    Command="{Binding DataContext.CloseTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Won't do…" Margin="0,0,6,6"
                                    Command="{Binding DataContext.WontDoCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Set ref…" Margin="0,0,6,6" ToolTip="Set its ref (test, commit or story) without closing it"
                                    Command="{Binding DataContext.SetRefCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Correct type…" Margin="0,0,6,6"
                                    Command="{Binding DataContext.CorrectTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Reword summary…" Margin="0,0,6,6" ToolTip="Correct its summary; the old wording stays in its history"
                                    Command="{Binding DataContext.CorrectSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Edit description…" Margin="0,0,6,6" ToolTip="Its markdown description, kept apart from the summary"
                                    Command="{Binding DataContext.EditDescriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Add link…" Margin="0,0,6,6"
                                    Command="{Binding DataContext.AddLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Assign…" Margin="0,0,6,6" ToolTip="Assign it to a member's login: it's dispatched only on that login"
                                    Command="{Binding DataContext.AssignCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Unassign" Margin="0,0,6,6" ToolTip="Take it off its member: it's handed out like any unassigned ticket"
                                    Command="{Binding DataContext.UnassignCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Reserve…" Margin="0,0,6,6" ToolTip="Set aside tokens for it (0 releases)"
                                    Command="{Binding DataContext.ReserveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Add note…" Margin="0,0,6,6" ToolTip="Append a comment to it (notes are never edited or deleted)"
                                    Command="{Binding DataContext.AddNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Estimate…" Margin="0,0,6,6" ToolTip="Set its effort estimate in tokens: within a priority the queue runs the smallest first (empty clears)"
                                    Command="{Binding DataContext.EstimateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource MaButton}" Content="Add label…" Margin="0,0,6,6" ToolTip="Label it (a component is a 'component:' label)"
                                    Command="{Binding DataContext.AddLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"
                                   Visibility="{Binding Error, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />

                        <!-- Labels (M.TIX-T74): click one to filter by it, ✕ takes it off. -->
                        <TextBlock Text="LABELS" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="No labels." Style="{StaticResource Muted}">
                            <TextBlock.Visibility>
                                <Binding Path="TicketLabels.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding TicketLabels}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource MaControlBorder}" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource LinkBtn}" Content="{Binding}" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.FilterByLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding StringFormat='Label {0}: show tickets with it'}" ToolTip="Show only tickets with this label" />
                                            <Button Style="{StaticResource MaToolButton}" Content="&#x2715;" Width="22" Height="22" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding StringFormat='Remove label {0}'}" ToolTip="Remove this label" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource ChangedMark}" Tag="{Binding LinksChanged}" Margin="0,16,0,6" VerticalAlignment="Bottom"
                                    Visibility="{Binding LinksChanged, Converter={StaticResource Visible}}">
                                <TextBlock Text="changed in this version" FontSize="12" />
                            </Border>
                            <TextBlock Text="LINKS" Style="{StaticResource SectionLabel}" />
                        </DockPanel>
                        <TextBlock Text="No links." Style="{StaticResource Muted}">
                            <TextBlock.Visibility>
                                <Binding Path="Links.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Links}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinkLine}">
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#x2715;" Width="26" Height="26" FontSize="10"
                                                Visibility="{Binding DataContext.IsCurrentVersion, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Visible}}"
                                                Command="{Binding DataContext.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding SpokenName, StringFormat='Remove link: {0}'}" ToolTip="Remove this link" />
                                        <TextBlock Text="{Binding Phrase}" Style="{StaticResource Muted}" Width="110" VerticalAlignment="Center" />
                                        <!-- Blocked state (M.TIX-T68): said in words, and in the error colour when it holds work up now. -->
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="12" VerticalAlignment="Center" Margin="6,0"
                                                   Visibility="{Binding State, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Blocking}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaRec}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Style="{StaticResource LinkBtn}" Content="{Binding Other}" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Other}"
                                                AutomationProperties.Name="{Binding SpokenName, StringFormat='{}{0}: go to it'}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Dependency graph (M.TIX-T83): the requires chains both ways, farthest prerequisites on top, what holds work up
                             in the error colour and in words, with the same graph as an indented text list for screen readers. -->
                        <StackPanel Visibility="{Binding HasDependencies, Converter={StaticResource Visible}}">
                            <TextBlock Text="DEPENDENCIES" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding DependencySummary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding GraphRows}" Focusable="False" AutomationProperties.Name="Dependency graph">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GraphRow}">
                                        <StackPanel>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Width="110" VerticalAlignment="Center" />
                                                <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:GraphChip}">
                                                            <Button Content="{Binding Text}" Margin="0,0,6,4" Padding="8,2" MinHeight="26" FontSize="12"
                                                                    ToolTip="{Binding Summary}" AutomationProperties.Name="{Binding SpokenName}"
                                                                    Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource MaButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                                                                <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Blocking}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource MaRec}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource MaRec}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Each row waits for the rows above it; a red outline holds work up now." Style="{StaticResource Muted}" Margin="0,2,0,6" />
                            <Expander Header="As a text list" Foreground="{DynamicResource MaText}" AutomationProperties.Name="Dependency graph as a text list">
                                <TextBox Text="{Binding DependencyText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                         Background="Transparent" Foreground="{DynamicResource MaText}" BorderThickness="0" Margin="0,4,0,0"
                                         HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Dependency graph, one ticket a line, indented by steps" />
                            </Expander>
                        </StackPanel>

                        <!-- Commits (M.TIX-T85): those whose subject names it, newest first; each opens on GitHub. -->
                        <TextBlock Text="COMMITS" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="No commits name it." Style="{StaticResource Muted}">
                            <TextBlock.Visibility>
                                <Binding Path="Commits.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Commits}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CommitLine}">
                                    <StackPanel Margin="0,0,0,8">
                                        <Button Style="{StaticResource LinkBtn}" Content="{Binding Hash}" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.OpenCommitCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Visibility="{Binding HasUrl, Converter={StaticResource Visible}}"
                                                AutomationProperties.Name="{Binding SpokenName}" ToolTip="{Binding Url}" />
                                        <TextBlock Text="{Binding Hash}" FontFamily="Cascadia Mono, Consolas"
                                                   Visibility="{Binding HasUrl, Converter={x:Static vm:Converters.TrueToCollapsed}}" />
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="NOTES" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="No notes." Style="{StaticResource Muted}">
                            <TextBlock.Visibility>
                                <Binding Path="Notes.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryLine}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="HISTORY" Style="{StaticResource SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryLine}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Story editor (M.TIX-T82): where the ticket detail pane goes, in the Stories view. Edits are kept until Save (Ctrl+S)
                 or Revert; a story changed elsewhere meanwhile isn't overwritten. -->
            <Border Grid.Column="1" Width="460" Background="{DynamicResource MaPane}" BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowsStoryEditor, Converter={StaticResource Visible}}">
                <ScrollViewer x:Name="StoryEditorPane" VerticalScrollBarVisibility="Auto" Focusable="False" DataContext="{Binding StoryEditor}">
                    <StackPanel Margin="20,16,20,20">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#x2715;" VerticalAlignment="Top"
                                    Command="{Binding DataContext.CloseStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AutomationProperties.Name="Close the story" ToolTip="Close the story (Esc); unsaved edits are kept" />
                            <TextBlock x:Name="StoryTitle" Text="{Binding Id}" Style="{StaticResource PaneTitle}" Focusable="True" FocusVisualStyle="{StaticResource MaFocusRing}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Repo}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding EpicText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Style="{StaticResource LinkBtn}" Content="Rename epic" VerticalAlignment="Center"
                                    Visibility="{Binding Epic.IsEpic, Converter={StaticResource Visible}, FallbackValue=Collapsed}"
                                    Command="{Binding DataContext.RenameEpicCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Epic}"
                                    AutomationProperties.Name="{Binding Epic.RenameName}" ToolTip="Rename the epic; its stories keep their IDs" />
                        </WrapPanel>

                        <Label Style="{StaticResource FilterLabel}" Content="St_atus" Target="{Binding ElementName=StoryStatus}" Margin="0,12,0,0" />
                        <ComboBox x:Name="StoryStatus" Style="{StaticResource Combo}" HorizontalAlignment="Left" MinWidth="140"
                                  ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding Status}" AutomationProperties.Name="Story status" />

                        <Label Style="{StaticResource FilterLabel}" Content="Story statemen_t" Target="{Binding ElementName=StoryStatement}" Margin="0,12,0,0" />
                        <TextBox x:Name="StoryStatement" Style="{StaticResource Field}" Text="{Binding Statement, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="False" MinHeight="54" IsReadOnly="{Binding IsTable}"
                                 AutomationProperties.Name="Story statement" ToolTip="As a ..., I can ..., so that ..." />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" Text="A story table row keeps its text in the table's cells: only its status is edited here."
                                   Visibility="{Binding IsTable, Converter={StaticResource Visible}}" />

                        <Label Style="{StaticResource FilterLabel}" Content="A_cceptance" Target="{Binding ElementName=StoryAcceptance}" Margin="0,12,0,0" />
                        <TextBox x:Name="StoryAcceptance" Style="{StaticResource Field}" Text="{Binding Acceptance, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="False" MinHeight="54" IsEnabled="{Binding CanEditText}"
                                 AutomationProperties.Name="Acceptance criteria" ToolTip="What has to be true for it to be done" />

                        <Label Style="{StaticResource FilterLabel}" Content="E_vidence" Target="{Binding ElementName=StoryEvidence}" Margin="0,12,0,0" />
                        <TextBox x:Name="StoryEvidence" Style="{StaticResource Field}" Text="{Binding Evidence, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="False" MinHeight="38" IsEnabled="{Binding CanEditText}"
                                 AutomationProperties.Name="Evidence" ToolTip="Where it's shown done: a test, commit or file" />

                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource MaPrimaryButton}" Content="Save" Margin="0,0,6,6" AutomationProperties.AcceleratorKey="Ctrl+S"
                                    Command="{Binding DataContext.SaveStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Save the story (Ctrl+S): rewrites the repo's USER_STORIES.md view" />
                            <Button Style="{StaticResource MaButton}" Content="Revert" Margin="0,0,12,6"
                                    Command="{Binding DataContext.RevertStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Drop the edits: back to the story as saved" />
                            <TextBlock Text="{Binding DirtyText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />

                        <TextBlock Text="IMPLEMENTED BY" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="No tickets implement it yet." Style="{StaticResource Muted}">
                            <TextBlock.Visibility>
                                <Binding Path="Implementers.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Implementers}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ImplementerLine}">
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#x2715;" Width="26" Height="26" FontSize="10"
                                                Command="{Binding DataContext.RemoveImplementerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding TicketId, StringFormat='Remove {0} as implementing it'}" ToolTip="Remove this link (Ctrl+Z puts it back)" />
                                        <Button Style="{StaticResource LinkBtn}" Content="{Binding TicketId}" VerticalAlignment="Center" Width="100" HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding TicketId}"
                                                AutomationProperties.Name="{Binding SpokenName, StringFormat='{}{0}: go to it'}" ToolTip="Open the ticket" />
                                        <TextBlock Text="{Binding State}" Style="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0" />
                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Summary}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource MaButton}" Content="Add implementing ticket&#x2026;" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Command="{Binding DataContext.AddImplementerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Link a ticket as implementing this story ('TICKET implements STORY'); Ctrl+Z undoes it" />

                        <TextBlock Text="OTHER LINKS" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="No other links." Style="{StaticResource Muted}">
                            <TextBlock.Visibility>
                                <Binding Path="Links.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Links}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinkLine}">
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="{Binding Phrase}" Style="{StaticResource Muted}" Width="110" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource LinkBtn}" Content="{Binding Other}" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Other}"
                                                AutomationProperties.Name="{Binding SpokenName, StringFormat='{}{0}: go to it'}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Undo toast (M.TIX-T80): after an undoable change, for a few seconds; Ctrl+Z undoes it whether or not it shows. -->
            <Border Grid.ColumnSpan="2" Style="{StaticResource MaCard}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                    Background="{DynamicResource MaPane}" BorderBrush="{DynamicResource MaControlBorder}" Panel.ZIndex="10"
                    Visibility="{Binding IsUndoToastShown, Converter={StaticResource Visible}}"
                    AutomationProperties.Name="Undo">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding UndoToast}" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="560" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding UndoToast}" />
                    <Button Style="{StaticResource MaPrimaryButton}" Content="_Undo" Command="{Binding UndoCommand}"
                            ToolTip="Undo it (Ctrl+Z): writes a compensating change; the history keeps both." />
                    <Button Style="{StaticResource MaToolButton}" Content="✕" Margin="8,0,0,0" Command="{Binding DismissUndoToastCommand}"
                            AutomationProperties.Name="Dismiss" ToolTip="Dismiss (Ctrl+Z still undoes it)" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer: status, last refresh, zoom, database. The hidden announcer speaks changes (4.1.3). -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="0,1,0,0" Padding="20,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding DbPath}" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding ZoomText}" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding LastRefresh, StringFormat='Refreshed {0}'}" Margin="16,0,0,0" />
                <TextBlock x:Name="Announcer" DockPanel.Dock="Right" Width="1" Height="1" Opacity="0" Focusable="False"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Announcement" />
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
