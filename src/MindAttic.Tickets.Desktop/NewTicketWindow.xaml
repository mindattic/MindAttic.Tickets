<Window x:Class="MindAttic.Tickets.Desktop.NewTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        mc:MaWindow.DarkTitleBar="True"
        Title="New ticket" Width="600" SizeToContent="Height" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="/logo.ico"
        Background="{DynamicResource MaPane}" Foreground="{DynamicResource MaText}" FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="New ticket" Style="{StaticResource Heading}" FontSize="17" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="It gets the repo's next free ID and is filed open. Features and chores wait for approval; fixes may be worked straight away." />

        <WrapPanel Margin="0,14,0,0">
            <StackPanel Margin="0,0,14,0">
                <Label Content="_Repo" Target="{Binding ElementName=Repo}" Foreground="{DynamicResource MaMuted}" Padding="0,0,0,3" />
                <ComboBox x:Name="Repo" Style="{StaticResource Combo}" MinWidth="260" IsTextSearchEnabled="True"
                          AutomationProperties.Name="Repo" AutomationProperties.IsRequiredForForm="True" />
            </StackPanel>
            <StackPanel>
                <Label Content="_Type" Target="{Binding ElementName=Type}" Foreground="{DynamicResource MaMuted}" Padding="0,0,0,3" />
                <ComboBox x:Name="Type" Style="{StaticResource Combo}" AutomationProperties.Name="Type" AutomationProperties.IsRequiredForForm="True" />
            </StackPanel>
        </WrapPanel>

        <Label Content="_Summary: one line, what and why" Target="{Binding ElementName=Summary}" Foreground="{DynamicResource MaMuted}" Padding="0,12,0,3" />
        <TextBox x:Name="Summary" Style="{StaticResource Field}" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top"
                 AutomationProperties.Name="Summary" AutomationProperties.IsRequiredForForm="True" />

        <Label Content="R_ef: story ID, test or commit (optional)" Target="{Binding ElementName=Ref}" Foreground="{DynamicResource MaMuted}" Padding="0,12,0,3" />
        <TextBox x:Name="Ref" Style="{StaticResource Field}" AutomationProperties.Name="Ref" />

        <Label Content="_Description: markdown, as long as it needs (optional)" Target="{Binding ElementName=Description}" Foreground="{DynamicResource MaMuted}" Padding="0,12,0,3" />
        <TextBox x:Name="Description" Style="{StaticResource Field}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" MaxHeight="320"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Description" />

        <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource PrimaryBtn}" Content="File ticket" IsDefault="True" MinWidth="100" Margin="0,0,8,0" Click="OnOk" />
            <Button Style="{StaticResource Btn}" Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
