<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MindAttic.Tickets</RootNamespace>
    <AssemblyName>MindAttic.Tickets</AssemblyName>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>2.0.0</Version>
    <PackageId>MindAttic.Tickets</PackageId>
    <Description>Workspace ticket engine and repo job runner for MindAttic: every repo's stories and tickets live in one SQLite database (data/Tickets.db).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Docs ship in the package; a missing comment on a self-describing member is not worth a warning. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Tickets.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Direct override: Microsoft.Data.Sqlite 10.0.9 floors SQLitePCLRaw.bundle_e_sqlite3 at
         2.1.11, which is vulnerable to CVE-2025-6965 (CVSS 9.8). Pinning a direct reference to a
         patched version wins NuGet's transitive version resolution (highest requested wins). Same
         fix as Prose.Core. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
