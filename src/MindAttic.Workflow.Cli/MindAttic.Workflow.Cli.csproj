<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MindAttic.Workflow.Cli</RootNamespace>
    <AssemblyName>workflow</AssemblyName>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>2.0.0</Version>
    <!-- Installed as a .NET global tool (~/.dotnet/tools is on PATH): tools/install.ps1. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>workflow</ToolCommandName>
    <PackageId>MindAttic.Workflow.Cli</PackageId>
    <Description>The workflow CLI: MindAttic's ticket engine and workspace repo jobs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MindAttic.Log" Version="3.0.0" />
    <PackageReference Include="MindAttic.Vault" Version="6.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- `workflow view` writes this page next to its data.js (docs/VIEWER.md). -->
    <EmbeddedResource Include="Viewer\index.html" LogicalName="viewer/index.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Workflow\MindAttic.Workflow.csproj" />
  </ItemGroup>

</Project>
