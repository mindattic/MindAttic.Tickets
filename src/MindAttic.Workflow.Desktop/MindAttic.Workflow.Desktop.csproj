<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MindAttic.Workflow.Desktop</RootNamespace>
    <!-- Not MindAttic.Workflow: the library already ships MindAttic.Workflow.dll beside it. -->
    <AssemblyName>MindAttic.Workflow.Desktop</AssemblyName>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
    <!-- The exe's own icon: Explorer, the shortcuts and the taskbar all show it. -->
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon for the window's title bar. -->
    <Resource Include="..\..\assets\logo.ico" Link="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MindAttic.Components.Wpf" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Workflow\MindAttic.Workflow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Workflow.Desktop.Tests" />
  </ItemGroup>

</Project>
