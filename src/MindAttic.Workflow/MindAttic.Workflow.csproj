<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MindAttic.Workflow</RootNamespace>
    <AssemblyName>MindAttic.Workflow</AssemblyName>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
    <PackageId>MindAttic.Workflow</PackageId>
    <Description>Workspace ticket engine and repo job runner for MindAttic: tickets live in each repo's docs/USER_STORIES.md.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Docs ship in the package; a missing comment on a self-describing member is not worth a warning. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Workflow.Tests" />
  </ItemGroup>

</Project>
